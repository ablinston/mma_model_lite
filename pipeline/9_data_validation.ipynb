    "## Check on all fighters with at least 1 fight in the data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "bb43b8bb-ae2f-435c-b505-6f39a269a0e3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5733 fights chosen\n"
     ]
    }
   ],
   "source": [
    "# Exclude columns containing these strings because they're expected to have some missing\n",
    "# Only look at fighter 1 first and not all will have made it past round 1. Percents can have 0 denominator\n",
    "exclude_strings = [\"_round2\", \"_round3\", \"_round4\", \"_round5\", \"opp_stance\", \"percent\", \"last_knocked\", \"over\"]\n",
    "\n",
    "# Get a list of columns where we expect no missing values\n",
    "columns_no_missing = [col for col in final_data.columns if all(sub not in col for sub in exclude_strings)]\n",
    "\n",
    "filtered_df = final_data[(final_data[\"fighter1_hist_fights\"] > 0) & (final_data[\"fighter2_hist_fights\"] > 0)]\n",
    "\n",
    "# Get a data frame of the counts of missing values\n",
    "missing_counts = pd.DataFrame(filtered_df[columns_no_missing].isna().sum(axis=0), columns=[\"nan_count\"])\n",
    "\n",
    "print(f\"{len(filtered_df)} fights chosen\")"
   ]
  },
