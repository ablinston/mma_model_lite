{
    // No interpreter path here on purpose. Workspace settings beat the ones the
    // devcontainer sets, so hardcoding the Windows conda env broke the container.
    // Pick the interpreter once per machine and VS Code remembers it.
    "python.condaPath": "X:/Programs/miniconda3/Scripts/conda.exe",
    "python.locator": "js",
    "python.terminal.activateEnvironment": true,
    "python.REPL.enableREPLSmartSend": false,
    "python.analysis.extraPaths": ["${workspaceFolder}"],
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    }
}
